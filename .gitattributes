# Normalise to LF in the repository. Without this, checkouts on Windows write
# CRLF into the Makefile and CI shell scripts, which then fail on Linux.
* text=auto eol=lf

*.go     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
Makefile text eol=lf

# PowerShell is the one place CRLF is the native convention.
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.gz  binary
*.zip binary

# Printer migration scripts are streamed directly to Bash.
/internal/printerlab/migration/** text eol=lf

# Preserve reviewed vendor bytes: the source gate fingerprints CRLF too.
/internal/printerlab/migration/tools/migration/tests/fixtures/qidi_save_variables.py -text whitespace=-blank-at-eol
/internal/printerlab/migration/tools/migration/tests/fixtures/qidi_1_6_0_* -text -whitespace
